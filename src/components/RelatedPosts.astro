---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug, formatDate } from '../utils/posts';
import IconArrowLeft from './icons/IconArrowLeft.astro';
import IconCalendar from './icons/IconCalendar.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <div class="my-12 pt-8 border-t border-slate-200 dark:border-slate-800">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900 dark:text-white">
        Related Publications
      </h3>
      <a href="/#articles" class="text-xs text-sky-600 dark:text-sky-400 hover:underline flex items-center gap-1 font-medium">
        View all articles
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {posts.map((post) => {
        const slug = getPostSlug(post);
        return (
          <a
            href={`/${slug}`}
            class="sharp-card rounded-md p-4 flex flex-col justify-between group block hover:border-sky-500/50"
          >
            <div>
              <span class="text-[10px] uppercase font-bold text-sky-600 dark:text-sky-400">
                {post.data.category}
              </span>
              <h4 class="font-bold text-sm text-slate-900 dark:text-white mt-1 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors line-clamp-2">
                {post.data.title}
              </h4>
            </div>
            <div class="mt-4 pt-2 border-t border-slate-100 dark:border-slate-800/60 flex items-center text-[11px] text-slate-400">
              <IconCalendar class="w-3 h-3 mr-1" />
              {formatDate(post.data.pubDate)}
            </div>
          </a>
        );
      })}
    </div>
  </div>
)}
