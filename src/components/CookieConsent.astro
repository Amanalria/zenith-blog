---
import IconShield from './icons/IconShield.astro';
---

<div
  id="cookie-consent-banner"
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 p-5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md shadow-2xl transition-all duration-300 translate-y-20 opacity-0 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and Privacy Consent"
>
  <div class="flex items-start gap-3 mb-3">
    <div class="p-2 rounded bg-sky-50 dark:bg-sky-950/60 text-sky-600 dark:text-sky-400 shrink-0">
      <IconShield class="w-4 h-4" />
    </div>
    <div>
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
        Privacy & Cookies
      </h3>
      <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mt-1">
        We use essential cookies to enhance site navigation, deliver personalized content, and analyze organic traffic under our <a href="/cookie-consent" class="text-sky-600 dark:text-sky-400 underline font-medium">Cookie Policy</a> and <a href="/privacy-policy" class="text-sky-600 dark:text-sky-400 underline font-medium">Privacy Policy</a>.
      </p>
    </div>
  </div>

  <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 dark:border-slate-800/80">
    <a
      href="/cookie-consent"
      class="px-3 py-1.5 text-xs text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors mr-auto"
    >
      Preferences
    </a>
    <button
      id="cookie-decline-btn"
      type="button"
      class="px-3.5 py-1.5 rounded-md border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-medium transition-colors"
    >
      Essential Only
    </button>
    <button
      id="cookie-accept-btn"
      type="button"
      class="px-4 py-1.5 rounded-md bg-sky-600 hover:bg-sky-500 text-white text-xs font-semibold shadow-sm transition-colors"
    >
      Accept All
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    const banner = document.getElementById('cookie-consent-banner');
    const acceptBtn = document.getElementById('cookie-accept-btn');
    const declineBtn = document.getElementById('cookie-decline-btn');

    if (!banner) return;

    // Check if consent was previously recorded
    const existingConsent = localStorage.getItem('cookie_consent');
    if (!existingConsent) {
      setTimeout(() => {
        banner.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        banner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
      }, 800);
    }

    function hideBanner(choice) {
      localStorage.setItem('cookie_consent', choice);
      banner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
      banner.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
    }

    acceptBtn?.addEventListener('click', () => hideBanner('accepted'));
    declineBtn?.addEventListener('click', () => hideBanner('declined'));
  })();
</script>
