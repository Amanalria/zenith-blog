---
interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props;
---

{totalPages > 1 && (
  <nav aria-label="Pagination" class="flex items-center justify-center gap-1.5 my-10 pt-8 border-t border-slate-200 dark:border-slate-800">
    <!-- Previous Button -->
    {prevUrl ? (
      <a
        href={prevUrl}
        class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-sky-600 hover:text-sky-600 transition-colors"
      >
        Prev
      </a>
    ) : (
      <span class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-800 text-slate-300 dark:text-slate-700 cursor-not-allowed">
        Prev
      </span>
    )}

    <!-- Numbered Page Links -->
    {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => {
      const isCurrent = pageNum === currentPage;
      const url = pageNum === 1 ? '/' : `/page/${pageNum}/`;
      return isCurrent ? (
        <span class="w-9 h-9 flex items-center justify-center text-xs font-bold bg-sky-600 text-white border border-sky-600">
          {pageNum}
        </span>
      ) : (
        <a
          href={url}
          class="w-9 h-9 flex items-center justify-center text-xs font-bold border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-sky-600 hover:text-sky-600 transition-colors"
        >
          {pageNum}
        </a>
      );
    })}

    <!-- Next Button -->
    {nextUrl ? (
      <a
        href={nextUrl}
        class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-sky-600 hover:text-sky-600 transition-colors"
      >
        Next
      </a>
    ) : (
      <span class="px-3.5 py-2 text-xs font-bold uppercase tracking-wider border border-slate-200 dark:border-slate-800 text-slate-300 dark:text-slate-700 cursor-not-allowed">
        Next
      </span>
    )}
  </nav>
)}
