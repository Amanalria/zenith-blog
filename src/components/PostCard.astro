---
import type { CollectionEntry } from 'astro:content';
import { getPostSlug, formatDate } from '../utils/posts';
import IconCalendar from './icons/IconCalendar.astro';
import IconClock from './icons/IconClock.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  priority?: boolean;
}

const { post, priority = false } = Astro.props;
const slug = getPostSlug(post);
const { title, description, pubDate, category, readTime, image, imageAlt } = post.data;
const postUrl = `/${slug}`;
const categoryUrl = `/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<article class="group flex flex-col bg-transparent">
  <!-- Post Thumbnail (16:9 ratio, smooth 8px rounded corners, zero outer box) -->
  {image && (
    <div class="overflow-hidden rounded-[8px] bg-slate-100 dark:bg-slate-800 aspect-[16/9] mb-3">
      <a href={postUrl} class="block h-full w-full overflow-hidden">
        <img
          src={image}
          alt={imageAlt || title}
          width="800"
          height="450"
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          decoding="async"
          class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-300 ease-out"
        />
      </a>
    </div>
  )}

  <!-- Title (Apple editorial typography: SF Pro tight tracking, crisp leading) -->
  <h2 class="text-[17px] sm:text-[19px] font-semibold tracking-[-0.022em] text-[#1d1d1f] dark:text-[#f5f5f7] group-hover:text-[#0071e3] dark:group-hover:text-[#2997ff] transition-colors leading-[1.35] mb-2 line-clamp-2">
    <a href={postUrl}>
      {title}
    </a>
  </h2>

  <!-- Excerpt / Summary -->
  <p class="text-[13px] sm:text-[13.5px] text-[#86868b] dark:text-[#a1a1a6] leading-relaxed mb-3 line-clamp-2 font-normal">
    {description}
  </p>

  <!-- Meta Info Line (Category • Date • Time) - Line placed BELOW with spacing -->
  <div class="flex items-center flex-wrap gap-2 text-[12px] text-[#86868b] dark:text-[#a1a1a6] pb-3 border-b border-[#d2d2d7]/60 dark:border-[#424245]/60">
    <a 
      href={categoryUrl} 
      class="font-semibold uppercase tracking-wider text-[11px] text-[#0071e3] dark:text-[#2997ff] hover:underline"
    >
      {category}
    </a>
    <span class="text-slate-300 dark:text-slate-700">•</span>
    <span class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
      <IconCalendar class="w-3.5 h-3.5 text-slate-400" />
      {formatDate(pubDate)}
    </span>
    <span class="text-slate-300 dark:text-slate-700">•</span>
    <span class="flex items-center gap-1 text-slate-500 dark:text-slate-400">
      <IconClock class="w-3.5 h-3.5 text-slate-400" />
      {readTime}
    </span>
  </div>
</article>
