---
import commentsData from '../data/comments.json';

interface Props {
  postSlug: string;
  postTitle: string;
}

const { postSlug, postTitle } = Astro.props;
const postComments = commentsData.filter(c => c.postSlug === postSlug);
---

<section class="my-12 pt-8 border-t border-slate-200 dark:border-slate-800" id="comments">
  <!-- Section Title -->
  <div class="border-b-2 border-slate-200 dark:border-slate-800 pb-2 mb-6">
    <h3 class="font-extrabold text-[15px] uppercase tracking-wider text-slate-900 dark:text-white relative">
      Discussion & Comments ({postComments.length})
      <span class="absolute -bottom-[10px] left-0 w-12 h-[2px] bg-sky-600"></span>
    </h3>
  </div>

  <!-- Comments List -->
  <div id="comments-list" class="space-y-4 mb-8">
    {postComments.map((c) => (
      <div class="p-4 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 bg-sky-600 text-white font-bold text-xs flex items-center justify-center">
              {c.author.charAt(0)}
            </span>
            <span class="font-bold text-xs text-slate-900 dark:text-white">{c.author}</span>
          </div>
          <span class="text-[11px] text-slate-400 font-mono">{c.date}</span>
        </div>
        <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed pl-9">
          {c.content}
        </p>
      </div>
    ))}
  </div>

  <!-- Sharp Comment Submission Form -->
  <div class="border border-slate-200 dark:border-slate-800 p-5 bg-slate-50/60 dark:bg-slate-900/40">
    <h4 class="font-bold text-xs uppercase tracking-wider text-slate-900 dark:text-white mb-3">
      Leave a Comment
    </h4>
    <form id="comment-form" data-slug={postSlug} data-title={postTitle} class="space-y-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Your Name *
          </label>
          <input
            type="text"
            id="comment-author"
            required
            placeholder="e.g. Rahul Sharma"
            class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:border-sky-600 rounded-none"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
            Email (Optional)
          </label>
          <input
            type="email"
            id="comment-email"
            placeholder="rahul@example.com"
            class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:border-sky-600 rounded-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-600 dark:text-slate-400 mb-1">
          Comment Message *
        </label>
        <textarea
          id="comment-body"
          rows="4"
          required
          placeholder="Share your thoughts or questions..."
          class="w-full px-3 py-2 text-xs border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-white focus:outline-none focus:border-sky-600 rounded-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="px-5 py-2.5 bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs uppercase tracking-wider transition-colors cursor-pointer rounded-none"
      >
        Submit Comment
      </button>
    </form>
    <div id="comment-success" class="hidden mt-3 p-3 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300 text-xs">
      Thank you! Your comment has been posted successfully.
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById('comment-form');
  const list = document.getElementById('comments-list');
  const success = document.getElementById('comment-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const author = document.getElementById('comment-author')?.value.trim();
    const body = document.getElementById('comment-body')?.value.trim();
    const postSlug = form.getAttribute('data-slug');
    const postTitle = form.getAttribute('data-title');

    if (!author || !body) return;

    const today = new Date().toISOString().split('T')[0];

    // Append directly to the UI
    const commentHtml = `
      <div class="p-4 border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 bg-sky-600 text-white font-bold text-xs flex items-center justify-center">
              ${author.charAt(0).toUpperCase()}
            </span>
            <span class="font-bold text-xs text-slate-900 dark:text-white">${author}</span>
          </div>
          <span class="text-[11px] text-slate-400 font-mono">${today}</span>
        </div>
        <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed pl-9">
          ${body}
        </p>
      </div>
    `;

    list?.insertAdjacentHTML('beforeend', commentHtml);

    // Save to local storage cache
    const stored = JSON.parse(localStorage.getItem('user_comments') || '[]');
    stored.push({
      author,
      content: body,
      postSlug,
      postTitle,
      date: today
    });
    localStorage.setItem('user_comments', JSON.stringify(stored));

    form.reset();
    if (success) {
      success.classList.remove('hidden');
      setTimeout(() => success.classList.add('hidden'), 5000);
    }
  });
</script>
