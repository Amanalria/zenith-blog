---
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  image = '/images/edge-architecture.webp',
  article = false,
  pubDate,
  updatedDate,
  author = siteConfig.author,
  category,
  canonicalUrl = Astro.url.href,
} = Astro.props;

const siteTitle = siteConfig.name;
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : siteConfig.url;
const resolvedImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Comprehensive Schema.org @graph for Google Rich Results, Reviews, Breadcrumbs & Entities
const isHome = canonicalUrl === siteUrl || canonicalUrl === `${siteUrl}/`;
const isReview = article && (category === 'Movie Reviews' || title.toLowerCase().includes('review'));

const breadcrumbs = article ? {
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl,
    },
    ...(category ? [{
      '@type': 'ListItem',
      position: 2,
      name: category,
      item: `${siteUrl}/category/${category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}/`,
    }] : []),
    {
      '@type': 'ListItem',
      position: category ? 3 : 2,
      name: title,
      item: canonicalUrl,
    },
  ],
} : null;

const schemaGraph: any[] = [];

if (isHome) {
  schemaGraph.push({
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: siteTitle,
    url: siteUrl,
    description: description,
    inLanguage: siteConfig.language,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    publisher: {
      '@id': `${siteUrl}/#organization`,
    },
  });

  schemaGraph.push({
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: siteTitle,
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
      width: 512,
      height: 512,
    },
    sameAs: ['https://t.me/+ZgCjyUOiBm04NDll'],
  });

  schemaGraph.push({
    '@type': 'SiteNavigationElement',
    name: siteConfig.categories.map((c) => c.name),
    url: siteConfig.categories.map((c) => `${siteUrl}/category/${c.slug}/`),
  });
} else if (article) {
  schemaGraph.push({
    '@type': 'NewsArticle',
    '@id': `${canonicalUrl}#article`,
    headline: title,
    description: description,
    image: {
      '@type': 'ImageObject',
      url: resolvedImageUrl,
      caption: title,
      width: 1200,
      height: 675,
    },
    datePublished: pubDate?.toISOString(),
    dateModified: (updatedDate || pubDate)?.toISOString(),
    inLanguage: siteConfig.language,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    author: {
      '@type': 'Person',
      name: author,
      jobTitle: siteConfig.authorRole,
      url: `${siteUrl}/about/`,
    },
    publisher: {
      '@type': 'Organization',
      name: siteTitle,
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon.svg`,
      },
    },
    articleSection: category || 'Entertainment',
  });

  if (isReview) {
    schemaGraph.push({
      '@type': 'Review',
      '@id': `${canonicalUrl}#review`,
      headline: title,
      author: {
        '@type': 'Person',
        name: author,
        jobTitle: siteConfig.authorRole,
      },
      publisher: {
        '@type': 'Organization',
        name: siteTitle,
      },
      datePublished: pubDate?.toISOString(),
      itemReviewed: {
        '@type': 'Movie',
        name: title.replace(/Movie Review.*$/i, '').replace(/Review.*$/i, '').trim(),
        image: resolvedImageUrl,
      },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: '4.5',
        bestRating: '5',
        worstRating: '1',
      },
    });
  }

  if (breadcrumbs) {
    schemaGraph.push(breadcrumbs);
  }
} else {
  // Category or Static Pages
  schemaGraph.push({
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    name: title,
    url: canonicalUrl,
    description: description,
    inLanguage: siteConfig.language,
    isPartOf: {
      '@type': 'WebSite',
      name: siteTitle,
      url: siteUrl,
    },
  });

  if (category) {
    schemaGraph.push({
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: canonicalUrl,
        },
      ],
    });
  }
}

const schemaOrg = {
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#0284c7" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#090d16" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

<!-- Resource Hints & Preconnect for Edge Speed -->
<link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
<link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
{article && image && (
  <link rel="preload" as="image" href={image} fetchpriority="high" />
)}

<!-- RSS Syndication, Sitemaps & AI Agent Manifest Autodiscovery -->
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs Context" />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedImageUrl} />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:locale" content="en_US" />
{article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{article && category && <meta property="article:section" content={category} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedImageUrl} />

<!-- JSON-LD Structured Data Schema for Google, Bing, and AI Assistant Bots -->
<script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
