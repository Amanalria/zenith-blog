---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import AdSlot from '../components/AdSlot.astro';
import Pagination from '../components/Pagination.astro';
import { siteConfig } from '../config/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

const pageSize = siteConfig.postsPerPage || 10;
const totalPages = Math.ceil(sortedPosts.length / pageSize);
const pagePosts = sortedPosts.slice(0, pageSize);
const nextUrl = totalPages > 1 ? '/page/2/' : undefined;
---

<BaseLayout
  title={siteConfig.siteTitle}
  description={siteConfig.description}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 md:py-10">
    <!-- Top Ad Slot (Only renders when ads.active is true) -->
    <AdSlot format="banner" slotId="home-top-banner" />

    <!-- Two-Column Layout (Responsive: Stacked on mobile, 2-col on desktop) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start my-4">
      
      <!-- Main Articles Feed (8 cols on desktop, full width on mobile) -->
      <main class="lg:col-span-8">
        {pagePosts.length === 0 ? (
          <div class="py-16 px-6 text-center border border-dashed border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900/60">
            <h2 class="text-sm font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 mb-2">
              No Articles Published Yet
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400 max-w-sm mx-auto leading-relaxed">
              Add your first markdown article to <code class="px-1.5 py-0.5 bg-slate-100 dark:bg-slate-800 font-mono text-[11px] text-sky-600 dark:text-sky-400">src/content/blog/</code> to publish it here.
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10">
            {pagePosts.map((post, index) => (
              <PostCard post={post} priority={index < 2} />
            ))}
          </div>
        )}

        <!-- Sharp Pagination Component (Only shown when multiple pages exist) -->
        {totalPages > 1 && (
          <Pagination
            currentPage={1}
            totalPages={totalPages}
            nextUrl={nextUrl}
          />
        )}
      </main>

      <!-- Sidebar (Visible on BOTH mobile and desktop - underneath articles on mobile, sticky on desktop) -->
      <div class="mt-8 lg:mt-0 lg:col-span-4 lg:sticky lg:top-24">
        <Sidebar />
      </div>

    </div>
  </div>
</BaseLayout>
