---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorBio from '../components/AuthorBio.astro';
import IconShield from '../components/icons/IconShield.astro';
---

<BaseLayout
  title="About Us - Zenith Edge Journal"
  description="Learn about the editorial mission, rigorous technical verification standards, and contributors behind Zenith Edge Journal."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="border-b border-slate-200 dark:border-slate-800 pb-8 mb-8">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-sky-50 dark:bg-sky-950/50 text-sky-600 dark:text-sky-400 text-xs font-semibold mb-3 border border-sky-200/50 dark:border-sky-800/50">
        <IconShield class="w-3.5 h-3.5" /> Editorial Transparency
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        About Zenith Edge Journal
      </h1>
      <p class="text-base text-slate-600 dark:text-slate-400 mt-3">
        Delivering rigorous engineering analysis, cloud architecture benchmarks, and developer-first documentation.
      </p>
    </div>

    <div class="prose prose-slate dark:prose-invert max-w-none text-slate-700 dark:text-slate-300">
      <h2>Our Mission</h2>
      <p>
        Zenith Edge Journal was founded to bridge the gap between speculative tech news and ground-truth software engineering. We believe technical content should be verifiable, reproducible, and stripped of marketing filler.
      </p>

      <h2>Editorial Standards & E-E-A-T Compliance</h2>
      <p>
        Every article published across our platform follows strict guidelines:
      </p>
      <ul>
        <li><strong>Code Verification:</strong> All code snippets, CLI instructions, and deployment manifests are tested in isolated environments before publication.</li>
        <li><strong>Zero Speculative Hallucination:</strong> Factual benchmarks, performance metrics, and pricing tables cite official source documentation.</li>
        <li><strong>Editorial Independence:</strong> Technical opinions, framework assessments, and cloud recommendations are determined strictly by performance and developer ergonomics.</li>
      </ul>

      <h2>Editorial Leadership</h2>
      <AuthorBio name="Zenith Technical Board" role="Systems Architects & Independent Researchers" />

      <h2>Contacting the Editorial Team</h2>
      <p>
        Have corrections, peer reviews, or technical questions? Reach out directly via our <a href="/contact" class="text-sky-600 dark:text-sky-400 font-semibold underline">Contact Portal</a>.
      </p>
    </div>
  </div>
</BaseLayout>
