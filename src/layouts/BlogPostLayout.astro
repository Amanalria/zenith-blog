---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AdSlot from '../components/AdSlot.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButtons from '../components/ShareButtons.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import CommentSection from '../components/CommentSection.astro';
import TelegramBanner from '../components/TelegramBanner.astro';
import Sidebar from '../components/Sidebar.astro';
import { formatDate, getPostSlug } from '../utils/posts';
import IconCalendar from '../components/icons/IconCalendar.astro';
import IconClock from '../components/icons/IconClock.astro';
import IconChevronRight from '../components/icons/IconChevronRight.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, headings, relatedPosts } = Astro.props;
const { title, description, pubDate, updatedDate, author, authorRole, category, readTime, image, imageAlt } = post.data;
const postSlug = getPostSlug(post);
const currentUrl = Astro.url.href;
---

<BaseLayout
  title={title}
  description={description}
  article={true}
  pubDate={pubDate}
  updatedDate={updatedDate}
  author={author}
  category={category}
  image={image}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 py-6 md:py-10">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumbs" class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400">Home</a>
      <IconChevronRight class="w-3 h-3 text-slate-400" />
      <a href={`/category/${category.toLowerCase().replace(/[^a-z0-9]/g, '-')}`} class="hover:text-sky-600 dark:hover:text-sky-400">
        {category}
      </a>
      <IconChevronRight class="w-3 h-3 text-slate-400" />
      <span class="text-slate-700 dark:text-slate-300 truncate max-w-[200px] sm:max-w-md">
        {title}
      </span>
    </nav>

    <!-- Article Header -->
    <header class="mb-8 border-b border-slate-200 dark:border-slate-800 pb-8">
      <div class="mb-4">
        <span class="inline-block text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-950/60 border border-sky-200/60 dark:border-sky-800/60 px-2.5 py-1">
          {category}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.2] mb-5">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed font-normal mb-6">
        {description}
      </p>

      <!-- Featured Banner Image (Sharp rectangular) -->
      {image && (
        <div class="my-6 overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 aspect-[16/9] max-h-[480px]">
          <img
            src={image}
            alt={imageAlt || title}
            width="800"
            height="450"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Author & Date Metadata -->
      <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400 pt-4 border-t border-slate-100 dark:border-slate-800/80">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-sky-600 text-white font-bold flex items-center justify-center text-xs">
            {author.charAt(0)}
          </div>
          <div>
            <div class="font-bold text-slate-800 dark:text-slate-200">{author}</div>
            <div class="text-[11px] text-slate-500">{authorRole}</div>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <span class="flex items-center gap-1.5">
            <IconCalendar class="w-3.5 h-3.5 text-slate-400" />
            Published: {formatDate(pubDate)}
          </span>
          <span class="flex items-center gap-1.5">
            <IconClock class="w-3.5 h-3.5 text-slate-400" />
            {readTime}
          </span>
        </div>
      </div>
    </header>

    <!-- Top Leaderboard Ad Slot -->
    <AdSlot format="banner" slotId="post-top-banner" />

    <!-- Two-column grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Main Content Column (8 cols) -->
      <div class="lg:col-span-8 min-w-0">
        <!-- Table of Contents -->
        <TableOfContents headings={headings} />

        <!-- Markdown Rendered Body -->
        <div class="prose prose-slate dark:prose-invert max-w-none 
          prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-slate-900 dark:prose-headings:text-white
          prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:border-b prose-h2:border-slate-200 dark:prose-h2:border-slate-800 prose-h2:pb-2
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:leading-relaxed prose-p:text-slate-700 dark:prose-p:text-slate-300
          prose-a:text-sky-600 dark:prose-a:text-sky-400 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
          prose-strong:text-slate-900 dark:prose-strong:text-white
          prose-code:text-sky-600 dark:prose-code:text-sky-400 prose-code:bg-slate-100 dark:prose-code:bg-slate-800/80 prose-code:px-1.5 prose-code:py-0.5 prose-code:font-mono prose-code:text-xs
          prose-pre:bg-slate-900 prose-pre:border prose-pre:border-slate-800
          prose-blockquote:border-l-4 prose-blockquote:border-sky-500 prose-blockquote:bg-slate-50 dark:prose-blockquote:bg-slate-900/40 prose-blockquote:p-4 prose-blockquote:italic
        ">
          <slot />
        </div>

        <!-- Official Telegram Channel Conversion Banner -->
        <TelegramBanner />

        <!-- Mid/In-Article Ad Slot -->
        <AdSlot format="in-feed" slotId="post-bottom-ad" />

        <!-- Social Share Section -->
        <ShareButtons title={title} url={currentUrl} />

        <!-- Author Bio Box -->
        <AuthorBio name={author} role={authorRole} />

        <!-- Working Comments Section -->
        <CommentSection postSlug={postSlug} postTitle={title} />

        <!-- Related Posts / Smart Interlinking -->
        <RelatedPosts posts={relatedPosts} />
      </div>

      <!-- Right Sidebar (Sticky on Desktop, stacks on mobile) -->
      <div class="mt-8 lg:mt-0 lg:col-span-4 lg:sticky lg:top-24">
        <Sidebar />
      </div>
    </div>
  </article>
</BaseLayout>
